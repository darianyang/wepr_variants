+ SANDER=pmemd.cuda
+ INP=07_prod.in
+ TOP=1lst_T121A_solv.prmtop
+ CRD=06_prod.rst
+ OUT=07_prod
+ pmemd.cuda -O -i 07_prod.in -p 1lst_T121A_solv.prmtop -c 06_prod.rst -r 07_prod.rst -o 07_prod.out -e 07_prod.ene -v 07_prod.vel -inf 07_prod.nfo -x 07_prod.nc
